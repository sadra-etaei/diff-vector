# ---- model weights -------------------------------------------------------
# Base model re-downloads with scripts/fetch_model.sh. The LoRA adapters are
# the only irreproducible artifacts here (36 min each to retrain) -- if you
# want them versioned, use git-lfs rather than deleting this rule.
models/

# ---- cached activations --------------------------------------------------
# results/perdoc_2x2.pt is 307MB and is the input to every number in the
# write-up. Regenerate with: python src/design_2x2.py
*.pt

# ---- raw corpora ---------------------------------------------------------
# Downloaded, not authored. Rebuild with prep_*.py.
data/raw/
reference/

# ---- derived corpora -----------------------------------------------------
# Deterministic given SEED=0 in the prep scripts; regenerate rather than commit.
data/*.json

# ---- tool / download noise -----------------------------------------------
# Download logs and smoke-test outputs are not results; local Claude Code
# settings are per-machine.
results/fetch_*.log
results/*_smoke*
.claude/

# ---- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ---- os / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Keep: src/, notes/, figures/, results/*.json, results/*.log, scripts/
